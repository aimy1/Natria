# Maintainer: aimy <aimy@users.noreply.github.com>

pkgname=natria-git
pkgver=0.4.5.r1.gaaaaaaa
pkgrel=1
pkgdesc='Natria - Intelligent Pair-Programming & AI Companion'
arch=('x86_64')
url='https://github.com/aimy1/Natria'
license=('MIT' 'OFL-1.1')
options=('!lto' '!strip' '!debug')
export LC_ALL=C.UTF-8
depends=('alsa-lib' 'chafa' 'gcc-libs' 'glibc' 'ripgrep')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=(
  'git: update default Shorin Wiki knowledge base'
  'fish: fish shell integration support'
  'bash: bash shell integration support'
  'zsh: zsh shell integration support'
)
provides=('natria')
conflicts=('natria')
# 字体(Noto CJK / Noto Emoji / JetBrains Mono)自 0.4.4 起 vendor 在源码树
# assets/fonts 下,不再从上游单独拉取。
source=(
  'natria::git+https://github.com/aimy1/Natria.git'
  'shorinwiki::git+https://github.com/SHORiN-KiWATA/Shorin-ArchLinux-Guide.git'
)
sha256sums=(
  'SKIP'
  'SKIP'
)

pkgver() {
  cd natria
  local version revision commit
  version="$(grep '^version = ' Cargo.toml | head -n1 | cut -d '"' -f2)"
  revision="$(git rev-list --count HEAD)"
  commit="$(git rev-parse --short HEAD)"
  printf '%s.r%s.g%s' "${version}" "${revision}" "${commit}"
}

prepare() {
  cd natria
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd natria
  cargo build --release --locked
}

package() {
  cd natria
  install -Dm755 "target/release/natria" "${pkgdir}/usr/bin/natria"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "assets/fonts/NotoSansCJK-Regular.ttc" "${pkgdir}/usr/share/natria/fonts/NotoSansCJK-Regular.ttc"
  install -Dm644 "assets/fonts/NotoColorEmoji.ttf" "${pkgdir}/usr/share/natria/fonts/NotoColorEmoji.ttf"
  install -Dm644 "assets/fonts/JetBrainsMono-Regular.ttf" "${pkgdir}/usr/share/natria/fonts/JetBrainsMono-Regular.ttf"
  install -Dm644 "assets/fonts/NotoSansCJK.LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/NotoSansCJK.LICENSE"
  install -Dm644 "assets/fonts/NotoColorEmoji.LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/NotoColorEmoji.LICENSE"
  install -Dm644 "assets/fonts/JetBrainsMono.LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/JetBrainsMono.LICENSE"

  if [[ -d src/memes ]]; then
    while IFS= read -r -d '' file; do
      local rel="${file#src/memes/}"
      install -Dm644 "${file}" "${pkgdir}/usr/share/natria/memes/${rel}"
    done < <(find src/memes -type f \( -name '*.json' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' -o -name '*.gif' -o -name '*.webp' \) -print0 | sort -z)
  fi

  if [[ -d src/scripts ]]; then
    while IFS= read -r -d '' file; do
      local rel="${file#src/scripts/}"
      install -Dm755 "${file}" "${pkgdir}/usr/share/natria/scripts/${rel}"
    done < <(find src/scripts -type f -print0 | sort -z)
  fi

  # Default knowledge base: kb (from natria repo)
  local kb_dir="${srcdir}/natria/kb"
  if [[ -d "${kb_dir}" ]]; then
    while IFS= read -r -d '' file; do
      local rel="${file#${kb_dir}/}"
      case "/${rel}" in
        */.git/*|*/pictures/*|*/legacy/*|*/Legacy/*|*/lagacy/*|*/Lagacy/*|*/Wikis/*) continue ;;
      esac
      install -Dm644 "${file}" "${pkgdir}/usr/share/natria/default-kb/kb/${rel}"
    done < <(find "${kb_dir}" -type f -name '*.md' -print0 | sort -z)
  fi

  # Default knowledge base: shorinwiki (from shorinwiki source, wiki/ subdir)
  local wiki_dir="${srcdir}/shorinwiki/wiki"
  if [[ -d "${wiki_dir}" ]]; then
    while IFS= read -r -d '' file; do
      local rel="${file#${wiki_dir}/}"
      case "/${rel}" in
        */.git/*|*/pictures/*|*/legacy/*|*/Legacy/*|*/lagacy/*|*/Lagacy/*|*/Wikis/*) continue ;;
      esac
      install -Dm644 "${file}" "${pkgdir}/usr/share/natria/default-kb/shorinwiki/${rel}"
    done < <(find "${wiki_dir}" -type f -name '*.md' -print0 | sort -z)
  fi

  # Default knowledge base: manifest
  install -d "${pkgdir}/usr/share/natria/default-kb/manifest"
  cat > "${pkgdir}/usr/share/natria/default-kb/manifest/manifest.json" <<EOF
{
  "name": "natria-default-kb",
  "generated_by": "natria-git PKGBUILD"
}
EOF
  local sw_commit
  sw_commit="$(git -C "${srcdir}/shorinwiki" rev-parse HEAD 2>/dev/null || echo '')"
  printf '%s\n' "${sw_commit}" > "${pkgdir}/usr/share/natria/default-kb/manifest/shorinwiki.commit"
}
